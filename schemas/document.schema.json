{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hebrew corpus document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "language",
    "text",
    "level",
    "categories",
    "split",
    "group_id",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "he"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "license",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    }
  }
}
