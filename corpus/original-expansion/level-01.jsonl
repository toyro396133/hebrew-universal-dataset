{"id":"hud26-w31-l01","language":"he","text":"מרכז מסלולי האופניים: הדרך הקצרה עברה ברחוב עמוס. מפת המסלול נזכר ברישום המקורי. הסיפור עדיין אינו מתאר את סיום העבודה.","level":1,"categories":["language","mapping"],"split":"validation","group_id":"hud26-w31","source":{"kind":"synthetic-original","license":"CC0-1.0","reference":"original-expansion-20261108/w31"},"topics":["geography","synthetic_worlds"],"axis_tags":{"linguistic_structure":["simple_sentence"],"reasoning_pattern":["direct"],"training_objectives":["retrieval"],"novelty":["novel_world"],"abstraction_depth":0},"metrics":{"reasoning_steps":1,"documents":1,"entities":3,"events":1}}
