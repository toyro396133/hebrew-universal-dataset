{"id":"hud26-w33-l01","language":"he","text":"חמ״ל תיקון הכביש: התיקון הפיזי הושלם. היתר פתיחת הנתיב נזכר ברישום המקורי. הסיפור עדיין אינו מתאר את סיום העבודה.","level":1,"categories":["language","coordination"],"split":"test","group_id":"hud26-w33","source":{"kind":"synthetic-original","license":"CC0-1.0","reference":"original-expansion-20261108/w33"},"topics":["decision_making","synthetic_worlds"],"axis_tags":{"linguistic_structure":["simple_sentence"],"reasoning_pattern":["direct"],"training_objectives":["retrieval"],"novelty":["new_rule"],"abstraction_depth":0},"metrics":{"reasoning_steps":1,"documents":1,"entities":3,"events":1}}
{"id":"hud26-w34-l01","language":"he","text":"מוקד התגובה לתקלות: תחילה נחשד החיישן. כרטיס התקלה נזכר ברישום המקורי. הסיפור עדיין אינו מתאר את סיום העבודה.","level":1,"categories":["language","coordination"],"split":"test","group_id":"hud26-w34","source":{"kind":"synthetic-original","license":"CC0-1.0","reference":"original-expansion-20261108/w34"},"topics":["decision_making","synthetic_worlds"],"axis_tags":{"linguistic_structure":["simple_sentence"],"reasoning_pattern":["direct"],"training_objectives":["retrieval"],"novelty":["new_rule"],"abstraction_depth":0},"metrics":{"reasoning_steps":1,"documents":1,"entities":3,"events":1}}
