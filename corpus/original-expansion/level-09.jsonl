{"id":"hud26-w01-l09","language":"he","text":"לפי נוהל העבודה: כאשר לחץ הכניסה נמוך מן הסף, פותחים נתיב גיבוי. לצד הכלל מופיע סייג: מד פגום מחייב מדידה נוספת. לכן גם אחרי זיהוי התנאי צריך לבדוק אם הסייג משנה את ההחלטה.","level":9,"categories":["exceptions","hydrology"],"split":"train","group_id":"hud26-w01","source":{"kind":"synthetic-original","license":"CC0-1.0","reference":"original-expansion-20261108/w01"},"topics":["engineering","synthetic_worlds"],"axis_tags":{"linguistic_structure":["paragraph"],"reasoning_pattern":["deduction"],"training_objectives":["reasoning"],"novelty":["seen"],"abstraction_depth":1},"metrics":{"reasoning_steps":3,"documents":1,"entities":3,"events":1}}
